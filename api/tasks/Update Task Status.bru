meta {
  name: Update Task Status
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/tasks/:task_id/status
  body: json
  auth: inherit
}

params:path {
  task_id: 3
}

body:json {
  {
    "status": "in_progress"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
