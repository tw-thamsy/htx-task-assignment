meta {
  name: Create Task
  type: http
  seq: 1
}

post {
  url: {{base_url}}/tasks
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Task X",
    "subtasks": [
      {
        "title": "Subtask X.1"
      },
      {
        "title": "Subtask X.2",
        "subtasks": [
          {
            "title": "Subtask X.2.1"
          }
        ]
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
